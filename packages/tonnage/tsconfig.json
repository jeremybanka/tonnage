{
	"extends": "../../tsconfig.json",
	"include": ["src", "__tests__", "examples", "*.config.ts", "README.mdx"],
	"contentMappers": [{ "package": "galley.mdx", "extensions": [".mdx"] }],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"jsx": "react-jsx",
		"jsxImportSource": "galley.mdx",
		"declaration": true,
		"paths": {
			"galley.mdx": ["../galley/src/index.ts"],
			"tonnage": ["./src/index.ts"]
		},
		"types": ["node"],
		"target": "ES2022"
	}
}
