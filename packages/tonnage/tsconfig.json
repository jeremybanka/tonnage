{
	"extends": "../../tsconfig.json",
	"include": [
		"src",
		"__tests__",
		"examples",
		"*.config.ts",
		"README.mdx"
	],
	"contentMappers": [
		{
			"package": "galley.md",
			"extensions": [
				".mdx"
			]
		}
	],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"jsx": "react-jsx",
		"jsxImportSource": "galley.md",
		"declaration": true,
		"paths": {
			"tonnage": [
				"./src/index.ts"
			]
		},
		"types": [
			"node"
		],
		"target": "ES2022"
	}
}
