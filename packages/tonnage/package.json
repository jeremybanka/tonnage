{
	"name": "tonnage",
	"version": "0.5.2",
	"description": "Bundle size reports for Galley documents.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/tonnage.git"
	},
	"license": "MPL-2.0",
	"author": "Jeremy Banka",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"AGENTS.md",
		"CHANGELOG.md",
		"dist",
		"src",
		"examples",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "vp pack",
		"pack:breakage": "pnpm --reporter=silent pack --out .breakage/package.tgz",
		"test:breakage:peers": "breakage npm check",
		"test": "vp test",
		"test:watch": "vp test watch"
	},
	"dependencies": {
		"esbuild": "0.28.2"
	},
	"devDependencies": {
		"@breakage/changesets": "0.1.0",
		"@types/node": "26.6.6",
		"breakage": "0.10.1",
		"galley.md": "0.3.1",
		"typescript": "7.1.0-dev.20261028.1"
	},
	"peerDependencies": {
		"galley.md": "^0.3.0"
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
