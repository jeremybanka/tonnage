{
	"name": "tonnage",
	"version": "0.2.0",
	"description": "Keep deterministic bundle size reports in README files and CI.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeremybanka/tonnage.git"
	},
	"license": "MPL-2.0",
	"author": "Jeremy Banka",
	"type": "module",
	"exports": {
		"./galley": {
			"types": "./dist/galley.d.mts",
			"import": "./dist/galley.mjs"
		},
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"bin": {
		"tonnage": "dist/cli.mjs"
	},
	"files": [
		"AGENTS.md",
		"CHANGELOG.md",
		"dist",
		"src",
		"examples",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "vp pack",
		"pack:breakage": "pnpm --reporter=silent pack --out .breakage/package.tgz",
		"test:breakage:peers": "breakage npm check",
		"test": "vp test",
		"test:watch": "vp test watch"
	},
	"dependencies": {
		"comline": "0.9.0",
		"esbuild": "0.28.2"
	},
	"devDependencies": {
		"@types/node": "26.6.5",
		"breakage": "0.8.5",
		"galley.md": "0.1.1",
		"typescript": "7.1.0-dev.20261020.3"
	},
	"peerDependencies": {
		"galley.md": "^0.1.1"
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
